<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pensum de Estudios</title>
    <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
    <div class="container">
        <h1>Pensum de Estudios de Ingenieria <%= carrera %></h1>

        <table class="pensum-table">
            <thead>
                <tr>
                    <th>Semestre / area</th>
                    <th>01</th>
                    <th>02</th>
                    <th>03</th>
                    <th>04</th>
                    <th>05</th>
                    <th>06</th>
                </tr>
            </thead>
            <tbody>
                <% semestres.forEach(semestre => { %>
                <tr>
                    <td class="semestre-cell">Semestre <%= semestre.numero %></td>

                    <% for(let area = 1; area <= 6; area++) { 
                        // Buscar cursos de este semestre y area
                        const cursosArea = semestre.cursos.filter(c => parseInt(c.area) === area);
                    %>
                    <td class="course-cell">
                        <% if(cursosArea.length === 0) { %>
                            <!-- Celda vacía -->
                        <% } else { %>
                            <% cursosArea.forEach(curso => { %>
                                <div 
                                    class="course-card" 
                                    id="curso-<%= curso.codigo %>" 
                                    data-codigo="<%= curso.codigo %>" 
                                    data-prerrequisitos='<%= JSON.stringify(curso.prerrequisitos) %>'>
                                    
                                    <span class="course-code"><%= curso.codigo %></span>
                                    <span class="course-name"><%= curso.nombre %></span>
                                    <span class="prerequisites">
                                        <% if (curso.prerrequisitos.length === 0) { %>
                                            Sin prerrequisitos
                                        <% } else { %>
                                            <%= curso.prerrequisitos.join(', ') %>
                                        <% } %>
                                    </span>
                                </div>
                            <% }) %>
                        <% } %>
                    </td>
                    <% } %>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <script src="/js/pensum.js"></script>
</body>
</html>
