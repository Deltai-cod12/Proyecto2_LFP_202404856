<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Proyecto 2</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <header>
    <nav>
      <ul>
        <li><button onclick="location.href='/'">Home</button></li>

          <% if (!lexicalErrors || lexicalErrors.length === 0) { %>
            <form id="formPensum" action="/pensum" method="POST" style="display:inline;">
              <input type="hidden" name="txtArea" id="pensumContent">
            </form>
          <% } %>

        <form id="formErrores" action="/error-report" method="GET" style="display:inline;">
          <input type="hidden" name="erroresJSON" id="erroresJSON" value='<%= JSON.stringify(lexicalErrors || []) %>'>
          <button type="submit">Reporte de Errores</button>
        </form>

        <li>
          <select id="archivoMenu">
            <option disabled selected>Archivo</option>
            <option value="limpiar">Limpiar Editor</option>
            <option value="cargar">Cargar Archivo</option>
            <option value="guardar">Guardar Archivo</option>
          </select>
        </li>
      </ul>
    </nav>
  </header>

  <main>
    <form action="/analyze" method="POST">
      <section id="editor-container">
        <h2>Editor de Entrada</h2>
      
        <div id="editor" contenteditable="true" spellcheck="false" class="editor">
          <%- codigo || '' %>
        </div>
      
        <input type="hidden" name="txtArea" id="txtAreaHidden">
      
        <button type="submit">Analizar</button>
      </section>
    </form>
    <section id="tablaTokens-container">
      <h2>Tabla de Tokens</h2>
      <table id="tablaTokens">
        <thead>
          <tr>
            <th>#</th>
            <th>Fila</th>
            <th>Columna</th>
            <th>Lexema</th>
            <th>Token</th>
          </tr>
        </thead>
        <tbody>
          <% if (tokens && tokens.length > 0) { %>
            <% tokens.forEach((token, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= token.fila %></td>
                <td><%= token.columna %></td>
                <td><%= token.lexema %></td>
                <td><%= token.token %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </section>
  </main>

  <input type="file" id="fileInput" accept=".plfp" style="display:none">
  <script src="/js/index.js"></script>
  <% if (tokens && tokens.length > 0) { %>
    <script>
      window.tokenList = <%- JSON.stringify(tokens).replace(/</g, '\\u003c') %>;
    </script>
  <% } %>
</body>
</html>