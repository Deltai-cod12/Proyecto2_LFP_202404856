<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>Reporte de Errores</title>
    <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><button onclick="location.href='/'">Home</button></li>
                <li><button onclick="location.href='/error-report'">Error Report</button></li>
                <li>
                    <select id="archivoMenu" disabled>
                        <option disabled selected>Archivo</option>
                    </select>
                </li>
            </ul>
        </nav>
    </header>

    <main>
        <section id="reporteErrores-container">
            <h2>Reporte de Errores Léxicos</h2>
            <% if (erroresLexicos && erroresLexicos.length > 0) { %>
            <table id="tablaErrores">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fila</th>
                        <th>Columna</th>
                        <th>Lexema</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    <% erroresLexicos.forEach((error, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= error.fila %></td>
                        <td><%= error.columna %></td>
                        <td><%= error.lexema %></td>
                        <td><%= error.token %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <% } else { %>
            <p>No se encontraron errores léxicos.</p>
            <% } %>
        </section>

        <section id="reporteErroresSintacticos-container">
            <h2>Reporte de Errores Sintácticos</h2>
            <% if (erroresSintacticos && erroresSintacticos.length > 0 && typeof erroresSintacticos[0] === 'object') { %>
            <table id="tablaErroresSintacticos">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fila</th>
                        <th>Columna</th>
                        <th>Lexema</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    <% erroresSintacticos.forEach((error, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= error.fila %></td>
                        <td><%= error.columna %></td>
                        <td><%= error.lexema %></td>
                        <td><%= error.token %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <% } else if (erroresSintacticos.length > 0 && typeof erroresSintacticos[0] === 'string') { %>
                <% erroresSintacticos.forEach((error) => { %>
                    <p><%= error %></p>
                <% }) %>
            <% } else { %>
                <p>No se encontraron errores sintácticos.</p>
            <% } %>
        </section>
    </main>
</body>
</html>
